{
  "$defs": {
    "AgentId": {
      "description": "6 个语义 Agent（Spec §8.1）。数量固定，新增需改 Spec。",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4",
        "A5"
      ],
      "title": "AgentId",
      "type": "string"
    },
    "AgentRegistryEntry": {
      "additionalProperties": false,
      "description": "一个 Agent 的治理卡片。**从上面的治理表派生**，不手写，所以永远与白名单一致。",
      "properties": {
        "agent_engine_mirror": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Engine Mirror"
        },
        "agent_id": {
          "$ref": "#/components/schemas/AgentId"
        },
        "forbidden_tool_patterns": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Tool Patterns",
          "type": "array"
        },
        "makes_tradeoffs": {
          "title": "Makes Tradeoffs",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/components/schemas/RuntimeId"
        },
        "tool_whitelist": {
          "items": {
            "type": "string"
          },
          "title": "Tool Whitelist",
          "type": "array"
        },
        "write_domains": {
          "items": {
            "$ref": "#/components/schemas/DataDomain"
          },
          "title": "Write Domains",
          "type": "array"
        }
      },
      "required": [
        "agent_id",
        "runtime",
        "role",
        "makes_tradeoffs",
        "tool_whitelist",
        "forbidden_tool_patterns",
        "write_domains"
      ],
      "title": "AgentRegistryEntry",
      "type": "object"
    },
    "CheckpointStatus": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "fields": {
          "default": 0,
          "title": "Fields",
          "type": "integer"
        },
        "last_saved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Saved At"
        },
        "restore_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restore Outcome"
        },
        "saves": {
          "default": 0,
          "title": "Saves",
          "type": "integer"
        },
        "stamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stamp"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "CheckpointStatus",
      "type": "object"
    },
    "DataDomain": {
      "description": "Spec §13.2 的数据域。跨域传递必须经过显式的边界模型。",
      "enum": [
        "student_private",
        "student_operational",
        "calendar",
        "wellbeing",
        "academic",
        "catalog_public",
        "aggregated_insights"
      ],
      "title": "DataDomain",
      "type": "string"
    },
    "ModelBackendStatus": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "backend": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend"
        },
        "default_model": {
          "title": "Default Model",
          "type": "string"
        },
        "generation_floor": {
          "title": "Generation Floor",
          "type": "string"
        },
        "last_model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Model Version"
        },
        "last_usage": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Usage"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "runtime": {
          "default": "strands",
          "title": "Runtime",
          "type": "string"
        },
        "sdk_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdk Version"
        },
        "tool_rejections_last_call": {
          "default": 0,
          "title": "Tool Rejections Last Call",
          "type": "integer"
        },
        "vertex_only": {
          "title": "Vertex Only",
          "type": "boolean"
        }
      },
      "required": [
        "available",
        "default_model",
        "generation_floor",
        "vertex_only"
      ],
      "title": "ModelBackendStatus",
      "type": "object"
    },
    "RecentSpan": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "name",
        "trace_id"
      ],
      "title": "RecentSpan",
      "type": "object"
    },
    "RuntimeId": {
      "description": "2 个 Runtime（Spec §8.1）。A4 独立部署是安全边界，不是性能优化。",
      "enum": [
        "student_path_runtime",
        "opportunity_ops_runtime"
      ],
      "title": "RuntimeId",
      "type": "string"
    },
    "TraceExportStatus": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "exporter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exporter"
        },
        "recent_spans": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/RecentSpan"
          },
          "title": "Recent Spans",
          "type": "array"
        },
        "spans_exported": {
          "default": 0,
          "title": "Spans Exported",
          "type": "integer"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "TraceExportStatus",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/AgentRegistry.json",
  "additionalProperties": false,
  "description": "`GET /v1/ops/agents`：系统里有哪些 Agent、各能碰什么、跑在什么模型上、\n状态存在哪、trace 往哪去——一屏说清，且每一项都是实测而非文档抄录。",
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/components/schemas/AgentRegistryEntry"
      },
      "title": "Agents",
      "type": "array"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "checkpoint": {
      "$ref": "#/components/schemas/CheckpointStatus"
    },
    "contracts_version": {
      "title": "Contracts Version",
      "type": "string"
    },
    "model_backend": {
      "$ref": "#/components/schemas/ModelBackendStatus"
    },
    "trace": {
      "$ref": "#/components/schemas/TraceExportStatus"
    }
  },
  "required": [
    "contracts_version",
    "agents",
    "model_backend",
    "checkpoint",
    "trace",
    "checked_at"
  ],
  "title": "AgentRegistry",
  "type": "object"
}
