{
  "$defs": {
    "CohortDims": {
      "additionalProperties": false,
      "description": "粗粒度分组维度。**只有这三项**——细到专业方向以下就可能反查到个人。\n\n三个字段都是**受约束类型**，不是自由文本。此前 ``school`` 与\n``development_mode`` 是裸 ``str``，于是\n``school=\"ENGG/COMP/AI-track/2024-intake/GPA3.7-3.8\"`` 完全合法——\n§17.1.2 要求\"仅粗粒度分组、不含专业方向以下的细分\"，\n而把细分塞进一个字符串既绕过了这条，也绕过了维度层数限制。",
      "properties": {
        "development_mode": {
          "$ref": "#/components/schemas/DevelopmentModeType",
          "description": "用枚举而非自由文本。枚举本来就存在，此前只是没接上"
        },
        "school": {
          "description": "学院代码，例如 'ENGG'。限制成短代码，塞不下更细的分层",
          "pattern": "^[A-Z]{2,6}$",
          "title": "School",
          "type": "string"
        },
        "year_level": {
          "maximum": 8,
          "minimum": 1,
          "title": "Year Level",
          "type": "integer"
        }
      },
      "required": [
        "school",
        "year_level",
        "development_mode"
      ],
      "title": "CohortDims",
      "type": "object"
    },
    "DevelopmentModeType": {
      "enum": [
        "employment",
        "academia",
        "entrepreneurship",
        "personal_interest",
        "exploration"
      ],
      "title": "DevelopmentModeType",
      "type": "string"
    },
    "MetricProvenance": {
      "description": "这条元组是**真的算出来的**，还是**造出来演示的**。\n\n两者绝不静默合并（2026-08-10 用户裁定 B）。冷启动的进程里派生侧本来就没有\n数据，如果把合成数据混进去充数，校方看到的每个百分比都失去意义。",
      "enum": [
        "derived",
        "synthetic"
      ],
      "title": "MetricProvenance",
      "type": "string"
    },
    "RequirementCategory": {
      "description": "出域时 ``MetricTuple.uncovered_requirement_categories`` 只携带这一层。\n\n它必须足够粗，粗到无法反推是哪位学生——所以是枚举而不是自由文本。",
      "enum": [
        "coursework",
        "technical_skill",
        "research_experience",
        "industry_experience",
        "project_portfolio",
        "teamwork_evidence",
        "communication",
        "credential",
        "language",
        "network",
        "eligibility_status"
      ],
      "title": "RequirementCategory",
      "type": "string"
    },
    "SurfaceConversion": {
      "additionalProperties": false,
      "description": "某一个入口（广场 / 为你推荐）上的「看见 → 行动」转化（Spec §17.6）。\n\n嵌在 :class:`MetricTuple` 里而不是另开一条流：广场转化的分母是**全部**\n广场曝光，不满足 ``seen ≤ eligible`` 那条嵌套约束（学生在广场上看到的\n包括他并不合格的机会——而那恰恰是校方最想知道的信号）。放进带自己\n局部不变量的子模型，既保住「每人每期一条元组」，也不动现有 validator。",
      "properties": {
        "acted_count": {
          "minimum": 0,
          "title": "Acted Count",
          "type": "integer"
        },
        "exposed_count": {
          "minimum": 0,
          "title": "Exposed Count",
          "type": "integer"
        },
        "surface": {
          "enum": [
            "plaza",
            "for_you"
          ],
          "title": "Surface",
          "type": "string"
        }
      },
      "required": [
        "surface",
        "exposed_count",
        "acted_count"
      ],
      "title": "SurfaceConversion",
      "type": "object"
    }
  },
  "$id": "https://campuspath.invalid/schema/MetricTuple.json",
  "additionalProperties": false,
  "description": "离开学生数据域时携带的全部内容（Spec §17.1.2）。\n\n计算发生在学生私有域内；这个对象是**计算结果**，出域时已无 student_id。\n原始曝光与行动记录永不离开。",
  "properties": {
    "acted_count": {
      "minimum": 0,
      "title": "Acted Count",
      "type": "integer"
    },
    "cohort_dims": {
      "$ref": "#/components/schemas/CohortDims"
    },
    "eligible_count": {
      "minimum": 0,
      "title": "Eligible Count",
      "type": "integer"
    },
    "gap_covered": {
      "minimum": 0,
      "title": "Gap Covered",
      "type": "integer"
    },
    "gap_total": {
      "minimum": 0,
      "title": "Gap Total",
      "type": "integer"
    },
    "period": {
      "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
      "title": "Period",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/components/schemas/MetricProvenance"
    },
    "seen_count": {
      "minimum": 0,
      "title": "Seen Count",
      "type": "integer"
    },
    "surface_conversions": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/SurfaceConversion"
      },
      "title": "Surface Conversions",
      "type": "array"
    },
    "uncovered_requirement_categories": {
      "default": [],
      "items": {
        "$ref": "#/components/schemas/RequirementCategory"
      },
      "title": "Uncovered Requirement Categories",
      "type": "array"
    }
  },
  "required": [
    "period",
    "cohort_dims",
    "provenance",
    "eligible_count",
    "seen_count",
    "acted_count",
    "gap_total",
    "gap_covered"
  ],
  "title": "MetricTuple",
  "type": "object"
}
