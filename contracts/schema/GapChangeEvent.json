{
  "$defs": {
    "GapChangeOrigin": {
      "description": "这条「缺口关闭」是怎么被发现的。两者都是真实派生，且必须可分。",
      "enum": [
        "replay",
        "observed"
      ],
      "title": "GapChangeOrigin",
      "type": "string"
    },
    "GapLevel": {
      "enum": [
        "missing",
        "partial",
        "satisfied",
        "unknown"
      ],
      "title": "GapLevel",
      "type": "string"
    },
    "RequirementCategory": {
      "description": "出域时 ``MetricTuple.uncovered_requirement_categories`` 只携带这一层。\n\n它必须足够粗，粗到无法反推是哪位学生——所以是枚举而不是自由文本。",
      "enum": [
        "coursework",
        "technical_skill",
        "research_experience",
        "industry_experience",
        "project_portfolio",
        "teamwork_evidence",
        "communication",
        "credential",
        "language",
        "network",
        "eligibility_status"
      ],
      "title": "RequirementCategory",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/GapChangeEvent.json",
  "additionalProperties": false,
  "description": "缺口等级变化的 append-only 事件——`GrowthTrajectory.gaps_closed` 的唯一来源。\n\n在此之前 `gaps_closed` 在 API 里硬编码为 0，注释写着「判定链未接入」。\n接上它要绕开一个陷阱：`gap_map()` 对已满足的要求是**跳过**的，所以缺口列表里\n永远不会出现 `satisfied`——「关闭」在数据上表现为**该 requirement_id 从列表里\n消失**。差分必须把「上一快照有、这一快照没有」判为 satisfied，否则\n`gaps_closed` 会永远是 0，只是换了个位置重犯同一个错。\n\nvalidator 要求 `to_level=satisfied` 必须挂证据（与 `Gap._satisfied_needs_evidence`\n同源）：`gaps_closed` 只能被**说得出是什么关闭了它**的事件加一。",
  "properties": {
    "category": {
      "$ref": "#/components/schemas/RequirementCategory"
    },
    "change_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Change Id",
      "type": "string"
    },
    "detected_at": {
      "format": "date-time",
      "title": "Detected At",
      "type": "string"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "from_level": {
      "$ref": "#/components/schemas/GapLevel"
    },
    "goal_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goal Id"
    },
    "origin": {
      "$ref": "#/components/schemas/GapChangeOrigin"
    },
    "requirement_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Requirement Id",
      "type": "string"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "term": {
      "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
      "title": "Term",
      "type": "string"
    },
    "to_level": {
      "$ref": "#/components/schemas/GapLevel"
    }
  },
  "required": [
    "change_id",
    "student_id",
    "requirement_id",
    "category",
    "term",
    "from_level",
    "to_level",
    "origin",
    "detected_at"
  ],
  "title": "GapChangeEvent",
  "type": "object"
}
