{
  "$defs": {
    "CapacityBudget": {
      "additionalProperties": false,
      "description": "路径版本对容量的承诺。超出即 B1 违规，除非 ``explicit_overload_warning``。",
      "properties": {
        "discretionary_capacity_hours": {
          "title": "Discretionary Capacity Hours",
          "type": "number"
        },
        "explicit_overload_warning": {
          "default": false,
          "title": "Explicit Overload Warning",
          "type": "boolean"
        },
        "period_end": {
          "format": "date",
          "title": "Period End",
          "type": "string"
        },
        "period_start": {
          "format": "date",
          "title": "Period Start",
          "type": "string"
        },
        "planned_hours": {
          "minimum": 0,
          "title": "Planned Hours",
          "type": "number"
        },
        "reserved_buffer_hours": {
          "minimum": 0,
          "title": "Reserved Buffer Hours",
          "type": "number"
        }
      },
      "required": [
        "period_start",
        "period_end",
        "discretionary_capacity_hours",
        "planned_hours",
        "reserved_buffer_hours"
      ],
      "title": "CapacityBudget",
      "type": "object"
    },
    "CoursePlan": {
      "additionalProperties": false,
      "description": "A5 产出。三个变体由 S1 `ParallelAgent` 并行生成。",
      "properties": {
        "confidence": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "course_items": {
          "items": {
            "$ref": "#/components/schemas/CoursePlanItem"
          },
          "minItems": 1,
          "title": "Course Items",
          "type": "array"
        },
        "degree_value": {
          "title": "Degree Value",
          "type": "number"
        },
        "explanation": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "gap_value": {
          "title": "Gap Value",
          "type": "number"
        },
        "goal_value": {
          "description": "A5 的取舍分数。只有 A5 的输出允许出现分数",
          "title": "Goal Value",
          "type": "number"
        },
        "plan_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "term": {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "title": "Term",
          "type": "string"
        },
        "total_credits": {
          "minimum": 0,
          "title": "Total Credits",
          "type": "number"
        },
        "validation_ids": {
          "items": {
            "pattern": "^val_[0-9a-f]{32}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Validation Ids",
          "type": "array"
        },
        "variant": {
          "$ref": "#/components/schemas/CoursePlanVariant"
        },
        "workload_cost": {
          "default": 0.0,
          "title": "Workload Cost",
          "type": "number"
        }
      },
      "required": [
        "plan_id",
        "student_id",
        "variant",
        "term",
        "course_items",
        "total_credits",
        "goal_value",
        "degree_value",
        "gap_value",
        "explanation",
        "validation_ids"
      ],
      "title": "CoursePlan",
      "type": "object"
    },
    "CoursePlanItem": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "course_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Course Id",
          "type": "string"
        },
        "credits": {
          "minimum": 0,
          "title": "Credits",
          "type": "number"
        },
        "offering_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offering Id"
        },
        "rationale": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "term": {
          "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
          "title": "Term",
          "type": "string"
        },
        "validation_id": {
          "description": "Rules 对该课程项的校验凭据；缺失即被 API 拒绝（Spec §8.9.3）",
          "pattern": "^val_[0-9a-f]{32}$",
          "title": "Validation Id",
          "type": "string"
        }
      },
      "required": [
        "course_id",
        "term",
        "credits",
        "validation_id"
      ],
      "title": "CoursePlanItem",
      "type": "object"
    },
    "CoursePlanVariant": {
      "description": "S1 ParallelAgent 的三套约束强度（Spec §8.1 表 S1）。",
      "enum": [
        "balanced",
        "ambitious",
        "low_load"
      ],
      "title": "CoursePlanVariant",
      "type": "string"
    },
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start"
      ],
      "title": "DateRange",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "description": "需要在 UI 展示的系统生成文案，两种语言都必须存在（Plan §2 UI 语言）。\n\n学生自己写的内容（Note、Reflection）**不用**这个类型——那是原文，不翻译。",
      "properties": {
        "en": {
          "minLength": 1,
          "title": "En",
          "type": "string"
        },
        "zh_Hans": {
          "minLength": 1,
          "title": "Zh Hans",
          "type": "string"
        }
      },
      "required": [
        "zh_Hans",
        "en"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "Milestone": {
      "additionalProperties": false,
      "properties": {
        "linked_goal_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linked Goal Id"
        },
        "milestone_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Milestone Id",
          "type": "string"
        },
        "plan_item_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Plan Item Ids",
          "type": "array"
        },
        "target_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Date"
        },
        "target_term": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}_(FALL|WINTER|SPRING|SUMMER)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Term"
        },
        "title": {
          "$ref": "#/components/schemas/LocalizedText"
        }
      },
      "required": [
        "milestone_id",
        "title"
      ],
      "title": "Milestone",
      "type": "object"
    },
    "PathwayDraftDiff": {
      "additionalProperties": false,
      "description": "草案相对**当前已采纳版本**的差异。审批弹窗要回答的是\"会变什么\"。\n\n只报数不报清单：条目本身就在 ``PathwayDraft.pathway`` 里，\n再复制一份就有两个出处，一旦漂移谁都说不清哪个是真的。",
      "properties": {
        "added_count": {
          "minimum": 0,
          "title": "Added Count",
          "type": "integer"
        },
        "carried_over_count": {
          "minimum": 0,
          "title": "Carried Over Count",
          "type": "integer"
        },
        "is_first_plan": {
          "description": "没有已采纳版本——这就是用户说的「第一次规划」那一刻",
          "title": "Is First Plan",
          "type": "boolean"
        },
        "removed_count": {
          "minimum": 0,
          "title": "Removed Count",
          "type": "integer"
        },
        "rescheduled_count": {
          "minimum": 0,
          "title": "Rescheduled Count",
          "type": "integer"
        }
      },
      "required": [
        "is_first_plan",
        "added_count",
        "removed_count",
        "rescheduled_count",
        "carried_over_count"
      ],
      "title": "PathwayDraftDiff",
      "type": "object"
    },
    "PathwayVersion": {
      "additionalProperties": false,
      "description": "多时间尺度路径（D1 要求三个视图数据同源，因此三者都从这里派生）。",
      "properties": {
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "capacity_budgets": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/CapacityBudget"
          },
          "title": "Capacity Budgets",
          "type": "array"
        },
        "course_plan": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/CoursePlan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "horizons": {
          "items": {
            "enum": [
              "next_two_weeks",
              "this_term",
              "long_term"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Horizons",
          "type": "array"
        },
        "milestones": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/Milestone"
          },
          "title": "Milestones",
          "type": "array"
        },
        "pathway_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Pathway Id",
          "type": "string"
        },
        "plan_items": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/PlanItem"
          },
          "title": "Plan Items",
          "type": "array"
        },
        "previous_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Version"
        },
        "student_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Student Id",
          "type": "string"
        },
        "trigger": {
          "description": "生成该版本的原因；初版为 'initial'",
          "title": "Trigger",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "pathway_id",
        "student_id",
        "version",
        "created_at",
        "trigger",
        "horizons"
      ],
      "title": "PathwayVersion",
      "type": "object"
    },
    "PlanItem": {
      "additionalProperties": false,
      "description": "A5 输出的最小单元。**每一个都必须携带 validation_id**（Spec §8.9.3）。",
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "conflicts": {
          "default": [],
          "items": {
            "$ref": "#/components/schemas/PlanItemConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "date_range": {
          "$ref": "#/components/schemas/DateRange"
        },
        "dependencies": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/components/schemas/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spec §16.4：任何计划项都要标明失败后的 fallback"
        },
        "kind": {
          "$ref": "#/components/schemas/PlanItemKind"
        },
        "milestone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Milestone"
        },
        "plan_item_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Plan Item Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/components/schemas/PlanItemStatus",
          "default": "proposed"
        },
        "subject_id": {
          "description": "course_id / opportunity_id / action_id",
          "maxLength": 128,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "title": {
          "$ref": "#/components/schemas/LocalizedText"
        },
        "validation_id": {
          "pattern": "^val_[0-9a-f]{32}$",
          "title": "Validation Id",
          "type": "string"
        },
        "workload_hours": {
          "default": 0.0,
          "minimum": 0,
          "title": "Workload Hours",
          "type": "number"
        }
      },
      "required": [
        "plan_item_id",
        "kind",
        "subject_id",
        "title",
        "date_range",
        "validation_id"
      ],
      "title": "PlanItem",
      "type": "object"
    },
    "PlanItemConflict": {
      "additionalProperties": false,
      "description": "一条**时段重叠的事实**（用户 2026-08-11 报障 A/B，Fable 5 裁定）。\n\n它只陈述「与谁重叠、重叠多少分钟」。**不含\"该不该去\"**——\n课能不能翘是学生的私人取舍（他知道那节课点不点名），系统不知道。\n取舍归 A5 排序，拍板归学生批准；这里只负责让冲突**说得出口**。\n\n检测发生在 Capacity & Calendar Service（纯区间数学、零 LLM，\n且全量时段真相只在它手里）；事实随 `PlanItem.validation_id` 一起\n过 B8 那道门。**前端不许自己再算一遍**——两套真相必然漂移。",
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/components/schemas/PlanItemConflictKind"
        },
        "label": {
          "$ref": "#/components/schemas/LocalizedText",
          "description": "给学生看的名字，如「HUMA 1030 · 汉语结构」"
        },
        "overlap_minutes": {
          "description": "重叠分钟数。**下限是 1**：零重叠不是冲突",
          "minimum": 1,
          "title": "Overlap Minutes",
          "type": "integer"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "with_id": {
          "description": "冲突对象：block_id 或 plan_item_id",
          "maxLength": 128,
          "minLength": 1,
          "title": "With Id",
          "type": "string"
        }
      },
      "required": [
        "with_id",
        "kind",
        "label",
        "starts_at",
        "ends_at",
        "overlap_minutes"
      ],
      "title": "PlanItemConflict",
      "type": "object"
    },
    "PlanItemConflictKind": {
      "description": "冲突对象的性质。分类只影响**怎么说**，不影响**要不要说**。",
      "enum": [
        "course",
        "protected",
        "planned_activity",
        "commitment"
      ],
      "title": "PlanItemConflictKind",
      "type": "string"
    },
    "PlanItemKind": {
      "enum": [
        "course",
        "opportunity",
        "action",
        "milestone"
      ],
      "title": "PlanItemKind",
      "type": "string"
    },
    "PlanItemStatus": {
      "enum": [
        "proposed",
        "accepted",
        "in_progress",
        "completed",
        "skipped",
        "blocked"
      ],
      "title": "PlanItemStatus",
      "type": "string"
    }
  },
  "$id": "https://campuspath.invalid/schema/PathwayDraft.json",
  "additionalProperties": false,
  "description": "一份**尚未落盘**的规划草案（2026-08-10 用户裁定 G）。\n\n用户原话：「第一次规划直接落盘 很不对劲」。所以生成与采纳被拆成两件事：\n草案存在 ``deps.pathway_drafts``，只有学生点了\"采纳\"才写进\n``deps.pathways``。``GET /pathway`` 从此**只读已采纳版本**。\n\n三条 ``rationale_*`` 是弹窗里的\"依据\"行——数据一直都在\n（``PlanItem.assumptions`` 与记忆 advisory），只是从没上过屏。\n要学生批准一件事，就得先让他看见这件事是凭什么来的。",
  "properties": {
    "adopted_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Adopted At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "diff": {
      "$ref": "#/components/schemas/PathwayDraftDiff"
    },
    "discarded_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discarded At"
    },
    "draft_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
    },
    "intensity": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Intensity",
      "type": "string"
    },
    "pathway": {
      "$ref": "#/components/schemas/PathwayVersion"
    },
    "rationale_goals": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rationale Goals",
      "type": "array"
    },
    "rationale_memory": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rationale Memory",
      "type": "array"
    },
    "rationale_profile": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rationale Profile",
      "type": "array"
    },
    "student_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    }
  },
  "required": [
    "draft_id",
    "student_id",
    "intensity",
    "created_at",
    "pathway",
    "diff"
  ],
  "title": "PathwayDraft",
  "type": "object"
}
